<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <add name="CarWashDb"
             connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\DBCarWash.mdf;Integrated Security=True;Connect Timeout=30"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <!-- Configure these values from your Meta WhatsApp Cloud API app. Keep the access token private. -->
        <add key="WhatsAppAccessToken" value="" />
        <add key="WhatsAppPhoneNumberId" value="" />
        <add key="WhatsAppReadyTemplate" value="car_wash_ready" />
        <add key="WhatsAppTemplateLanguage" value="en_US" />
        <add key="WhatsAppGraphVersion" value="v22.0" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
